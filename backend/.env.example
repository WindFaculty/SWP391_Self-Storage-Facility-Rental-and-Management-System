# Documentation only: export these variables before starting Spring Boot.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8088/api/v1/login/oauth2/code/google
GOOGLE_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production requires a separate strong JWT_SECRET and HTTPS/Secure cookies.
# JWT_SECRET=
