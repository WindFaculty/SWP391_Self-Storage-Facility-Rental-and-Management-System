# Documentation only: export these variables before starting Spring Boot.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8088/api/v1/login/oauth2/code/google
GOOGLE_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
# VNPay Sandbox credentials must belong to the same merchant terminal.
# run.ps1 also supports key/Vnpay_tmn_code.key and key/Vnpay_secret.key (Git-ignored).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8088/api/v1/payments/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/payment/result
# Local Sandbox only: settle a signed return using the same checks as IPN.
# Staging/production must use the public IPN endpoint and keep this false.
VNPAY_CONFIRM_ON_RETURN=true
# Production requires a separate strong JWT_SECRET and HTTPS/Secure cookies.
# JWT_SECRET=
