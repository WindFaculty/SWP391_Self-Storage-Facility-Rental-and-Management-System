# Public URL only; set the real approved HTTPS endpoint in Cloudflare Pages.
# Include /api/v1 exactly once. Empty uses the Vite development proxy.
VITE_API_BASE_URL=

# Google OAuth client ID/secret are configured only on the backend.
# Public Facebook identifier (never put Facebook App Secret in VITE_*).
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_API_VERSION=v25.0
